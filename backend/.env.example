PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://gitdocs_user:gitdocs_password@localhost:5432/gitdocs_db?schema=public"
GITHUB_WEBHOOK_SECRET="generate-a-random-secret"
GITHUB_WEBHOOK_URL="https://your-public-domain.example/api/webhooks"
CORS_ORIGIN="http://localhost:3000"
# Required: generate separately with: openssl rand -hex 32
INTERNAL_AUTH_SECRET="replace-with-at-least-32-random-characters"
ENCRYPTION_KEY="replace-with-64-random-hex-characters"
ENCRYPTION_KEY_VERSION="v1"
# ENCRYPTION_KEY_PREVIOUS="previous-64-hex-character-key-during-rotation"
GEMINI_API_KEY="your-google-gemini-api-key"
# Choose an available model for your Google project; there is no implicit model fallback.
GEMINI_MODEL=""
GEMINI_TIMEOUT_MS=60000
