{
  "name": "gitdocs",
  "version": "1.0.0",
  "description": "GitDocs & PR-Committer - Automated PR review and documentation bot with Next.js dashboard",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build:backend": "npm --workspace=backend run build",
    "build:frontend": "npm --workspace=frontend run build",
    "typecheck": "npm --workspace=backend run typecheck"
  },
  "keywords": [
    "github-bot",
    "pr-review",
    "gemini-ai",
    "nextjs",
    "express",
    "prisma"
  ],
  "author": "",
  "license": "MIT"
}
